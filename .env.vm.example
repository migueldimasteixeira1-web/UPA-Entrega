# Copie este arquivo para .env antes de iniciar a VM.
# cp .env.vm.example .env

# HTTPS obrigatório: scripts/iniciar-vm.sh gera um certificado autoassinado
# automaticamente (CN = host de PUBLIC_APP_URL). Para domínio público, troque
# os arquivos em deploy/certs/ por um certificado real (ex.: Let's Encrypt).
UPA_PORT=80
UPA_HTTPS_PORT=443
PUBLIC_APP_URL=https://IP-OU-DNS-DA-VM
CORS_ORIGINS=https://IP-OU-DNS-DA-VM

POSTGRES_DB=upa_entrega
POSTGRES_USER=upa
POSTGRES_PASSWORD=troque-por-uma-senha-forte

JWT_SECRET=gere-uma-chave-longa-e-aleatoria-com-pelo-menos-32-chars
JWT_EXPIRES_IN=8h

# Storage de anexos (receita médica, foto de comprovação — issue #38),
# via MinIO self-hosted (container "minio" no compose.yaml).
S3_BUCKET=upa-entrega
S3_ACCESS_KEY=troque-por-um-usuario-forte
S3_SECRET_KEY=troque-por-uma-senha-forte

# true apenas na primeira subida / homologação
SEED_DEMO_DATA=false

# Opcionais — sobrescrevem os padrões de deploy/backup-db.sh (pasta ./backups,
# retenção de 14 dias). Veja "Backup do banco" no README.
# BACKUP_DIR=/caminho/fora/do/repo/backups
# RETENTION_DAYS=14

# E-mail de confirmação de pedido (carrega o PIN — ver issue #35). Sem
# SMTP_HOST, o sistema só funciona pelo comprovante impresso. Exige domínio
# próprio verificado (SPF/DKIM/DMARC) no provedor escolhido para não cair em
# spam — pendência de infra, não bloqueia o funcionamento do resto do sistema.
# SMTP_HOST=smtp.seuprovedor.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=UPA Entrega <nao-responda@seudominio.com>
