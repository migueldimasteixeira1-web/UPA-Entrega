DATABASE_URL=postgresql://upa:upa_secret@localhost:5432/upa_entrega?schema=public
JWT_SECRET=upa_entrega_jwt_secret_change_in_production
JWT_EXPIRES_IN=8h
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SEED_DEMO_DATA=true

# E-mail de confirmação de pedido (PIN) — sem SMTP_HOST configurado, os
# e-mails só são logados no console em vez de enviados de verdade (ver
# issue #35). Pendente: domínio próprio com SPF/DKIM/DMARC antes de produção
# real, senão o provedor tende a marcar como spam.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=UPA Entrega <nao-responda@upa-entrega.local>
EMAIL_WORKER_INTERVAL_MS=10000

# Storage de anexos (receita médica, foto de comprovação — issue #38).
# MinIO local sobe junto com o Postgres via ./iniciar-local.sh.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=upa-entrega
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Otimização automática da sequência de entrega no despacho (issue #73).
# Geocodificação por CEP (AwesomeAPI) já funciona sem chave nenhuma — só o
# cálculo da rota em si (endpoint de otimização do OpenRouteService,
# openrouteservice.org, grátis dentro da cota) exige ORS_API_KEY. Sem ela,
# o despacho usa a ordem em que os pedidos ficaram prontos (FIFO), sem
# otimização — nunca trava o cadastro nem o despacho.
ORS_API_KEY=
