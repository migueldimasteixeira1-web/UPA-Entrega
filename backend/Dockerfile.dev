FROM node:20-alpine

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY prisma ./prisma
RUN npx prisma generate

COPY . .

EXPOSE 3001

CMD ["sh", "-c", "npx prisma generate && npx prisma migrate deploy && if [ \"$SEED_DEMO_DATA\" = \"true\" ]; then node prisma/seed.js; fi && npm run dev"]
