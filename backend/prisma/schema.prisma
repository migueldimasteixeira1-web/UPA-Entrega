generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  OPERADOR
  ENTREGADOR
}

enum OrderStatus {
  PEDIDO_RECEBIDO
  EM_SEPARACAO
  SEPARADO
  AGUARDANDO_SAIDA
  EM_ROTA
  ENTREGUE
  CANCELADO
}

enum RouteStatus {
  EM_ANDAMENTO
  FINALIZADA
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(OPERADOR)
  phone     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ordersCreated   Order[]        @relation("CreatedBy")
  ordersDelivered Order[]        @relation("DeliveredBy")
  historyEntries  OrderHistory[]
  routesAsCourier Route[]        @relation("CourierRoutes")
  routesCreated   Route[]        @relation("RouteCreatedBy")
}

model Patient {
  id        String   @id @default(uuid())
  name      String
  cpf       String   @unique
  phone     String
  email     String?
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  addresses Address[]
  orders    Order[]
}

model Address {
  id             String   @id @default(uuid())
  patientId      String
  label          String
  street         String
  number         String
  complement     String?
  neighborhood   String
  city           String
  state          String
  zipCode        String?
  referencePoint String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  orders  Order[]
}

model Medication {
  id        String   @id @default(uuid())
  name      String
  unit      String   @default("unidade")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems OrderItem[]
}

model Route {
  id          String      @id @default(uuid())
  routeNumber String      @unique
  courierId   String
  createdById String
  status      RouteStatus @default(EM_ANDAMENTO)
  notes       String?
  startedAt   DateTime    @default(now())
  finishedAt  DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  courier   User    @relation("CourierRoutes", fields: [courierId], references: [id])
  createdBy User    @relation("RouteCreatedBy", fields: [createdById], references: [id])
  orders    Order[]
}

model Order {
  id             String      @id @default(uuid())
  orderNumber    String      @unique
  patientId      String
  addressId      String
  patientName    String
  patientPhone   String
  patientCpf     String
  patientEmail   String?
  street         String
  number         String
  complement     String?
  neighborhood   String
  city           String
  state          String
  zipCode        String?
  referencePoint String?
  internalNotes  String?
  patientNotes   String?
  prescriptionKey String?
  deliveryPinHash String
  routeId        String?
  routeSequence  Int?
  status         OrderStatus @default(PEDIDO_RECEBIDO)
  publicToken    String      @unique @default(uuid())
  deliveredAt    DateTime?
  deliveredById  String?
  cancelReason   String?
  createdById    String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  patient     Patient        @relation(fields: [patientId], references: [id])
  address     Address        @relation(fields: [addressId], references: [id])
  createdBy   User           @relation("CreatedBy", fields: [createdById], references: [id])
  deliveredBy User?          @relation("DeliveredBy", fields: [deliveredById], references: [id])
  route       Route?         @relation(fields: [routeId], references: [id])
  items       OrderItem[]
  history     OrderHistory[]
  emails      EmailNotification[]
}

model OrderItem {
  id             String @id @default(uuid())
  orderId        String
  medicationId   String
  quantity       Int
  medicationName String
  unit           String

  order      Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  medication Medication @relation(fields: [medicationId], references: [id])
}

model OrderHistory {
  id         String       @id @default(uuid())
  orderId    String
  userId     String?
  action     String
  fromStatus OrderStatus?
  toStatus   OrderStatus?
  details    String?
  createdAt  DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id])
}

// Contador atômico para numeração diária (pedidos/rotas). O incremento é
// feito com um único UPSERT (INSERT ... ON CONFLICT ... DO UPDATE) em vez de
// COUNT+INSERT, para não haver corrida entre duas criações concorrentes no
// mesmo dia.
model DailyCounter {
  id      Int    @id @default(autoincrement())
  scope   String
  dateKey String
  counter Int    @default(0)

  @@unique([scope, dateKey])
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

// Fila de e-mail assíncrona: criar o pedido nunca deve esperar (nem falhar)
// por causa do provedor de e-mail estar lento/fora do ar. Um worker separado
// (lib/email/worker.js) processa as linhas PENDING/FAILED com retentativa.
model EmailNotification {
  id        String      @id @default(uuid())
  orderId   String
  type      String
  to        String
  subject   String
  html      String
  status    EmailStatus @default(PENDING)
  attempts  Int         @default(0)
  lastError String?
  sentAt    DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status])
}
